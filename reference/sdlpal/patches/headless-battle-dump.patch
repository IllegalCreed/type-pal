+/* type-pal: 把战斗 lpSceneBuf(8-bit indexed surface)用当前 palette 转 RGBA + 写 PNG。
+ * 由 battle.c PAL_BattleMain 在 paint 完后调一次。 */
+int
+PAL_DumpBattleSceneToPng(SDL_Surface *surf)
+{
+   SDL_Color     *pColors;
+   unsigned char *pRGBA;
+   int            W, H, x, y;
+
+   if (g_dump_battle_out == NULL) {
+      fprintf(stderr, "[dump-battle] g_dump_battle_out NULL\n");
+      return 1;
+   }
+
+   pColors = PAL_GetPalette(g_dump_battle_palette, FALSE);
+   if (pColors == NULL) {
+      fprintf(stderr, "[dump-battle] PAL_GetPalette(%d) failed\n", g_dump_battle_palette);
+      return 2;
+   }
+
+   W = surf->w;
+   H = surf->h;
+   pRGBA = (unsigned char *)malloc((size_t)W * H * 4);
+   if (pRGBA == NULL) {
+      fprintf(stderr, "[dump-battle] malloc rgba failed\n");
+      return 3;
+   }
+
+   {
+      const unsigned char *pSrc = (const unsigned char *)surf->pixels;
+      const int            iPitch = surf->pitch;
+      for (y = 0; y < H; y++) {
+         for (x = 0; x < W; x++) {
+            unsigned char idx = pSrc[y * iPitch + x];
+            unsigned char *dst = &pRGBA[(y * W + x) * 4];
+            dst[0] = pColors[idx].r;
+            dst[1] = pColors[idx].g;
+            dst[2] = pColors[idx].b;
+            dst[3] = 255;
+         }
+      }
+   }
+
+   if (!stbi_write_png(g_dump_battle_out, W, H, 4, pRGBA, W * 4)) {
+      fprintf(stderr, "[dump-battle] stbi_write_png(%s) failed\n", g_dump_battle_out);
+      free(pRGBA);
+      return 4;
+   }
+
+   fprintf(stderr, "[dump-battle] wrote %s (%dx%d, palette=%d, enemyTeam=%d, battleField=%d, party=%d)\n",
+           g_dump_battle_out, W, H,
+           g_dump_battle_palette, g_dump_battle_enemy_team,
+           g_dump_battle_field, g_dump_battle_party_count);
+
+   free(pRGBA);
    return 0;
 }
 
