    {
      "path": "packages/game/src/core/battle/battle-finalization.ts",
      "sha256": "b7f5b9751b4d766220dcc23e32227113da25ae54e1e7e793f7be17b197f3b51f",
      "lines": 67,
      "dimensions": {
        "A": "函数正文守恒、同一清毒／装备绑定；实际清理与resume序按3u/3w证据复用，非队员Extra仍unknown不改循环。",
        "B": "现注释明确临时<=999/装备>999及party角色域差异，不冒称全C等价。",
        "C": "状态清理直接依赖equipment-state/player-poison-state，去除该层对装备脚本/解释器转出口的无关依赖；宿主仍直接加载两facade。",
        "D": "复用既有owner同一函数，无复制或万能context。",
        "E": "旧finalization/runtime有效六单红及合法fixture复用；当前40相邻、TC0不作为整文件验收。",
        "F": "lost/fled/watchdog owner及清理顺序原样，不为行数改名。",
        "G": "仅移除两条间接导入；没有新出口/模式参数。",
        "H": "正式GS/startBattle/resume可观察，不新mock清理函数；纯重构用正文/绑定等式和实际回归。"
      },
      "decision": "review; module gates and actual remaining contracts pending"
    },
    {
      "path": "packages/game/src/core/battle/battle-progression.ts",
      "sha256": "40d5caa83a46734d689defc26178679cac6af82b5127d8739264a7aeb626b0a4",
      "lines": 307,
      "dimensions": {
        "A": "普通成长／快照正文不变；WORD新分歧单列draft、未修，不关整文件。",
        "B": "主999 cap/隐藏不套该cap与RNG算法范围已分开；不授全极端等价。",
        "C": "getter走equipment-state，数字输出类型走中性data模块，不再依赖结算编排。GS仍按当前公开合同提供Exp/Runtime/装备状态，无新增越层写。",
        "D": "getter复用同一绑定；主升级/隐藏/0x8D重置与RNG合同不同，不因相似循环强行共享。",
        "E": "复用11主升级/H02五例及旧额外RNG单红；七池缺口另补，不由40绿推定完成。",
        "F": "每role的主升级→快照→隐藏→学法术顺序保持；长函数仍作阅读热点，不按指标拆出宽参数helper。",
        "G": "未增fallback/死分支；现公开stat/label返回字段与party输入合同保留，不擅自删除出口字段。",
        "H": "RNG可注入，数值直接走公开函数观测；旧记录型RNG的fallback不得替代完整参数/业务值断言。"
      },
      "decision": "review; module gates and actual remaining contracts pending"
    },
    {
      "path": "packages/game/src/core/battle/battle-settlement.ts",
      "sha256": "e046f2c9fc21fb9c229c33041f47a487536b6f1a7bc1fb42644d4051e567d5a9",
      "lines": 227,
      "dimensions": {
        "A": "完整执行JS相同；真实caller与10原盘post leaf、特殊结局/hold/清理原件按原限制复用。",
        "B": "Phase C/E/F、首帧残键、C恒真半恢复注释与原证据一致；本轮不增加真值断言。",
        "C": "该模块只组织屏/等待/脚本收尾；纯数据声明移到共享data，避免数字owner反向引用编排。",
        "D": "三type只有一个定义，原出口仅type re-export；不把数字/IO/屏等待合万能服务。",
        "E": "旧8例和后继16合同/反控据证复用，当前40包含主测/宿主/绘制相邻；不扩大到视觉验收。",
        "F": "阶段命名与推进顺序不变，类型转发明确。",
        "G": "原三声明移走不留双定义；原公共type名字保留，未造兼容执行分支。",
        "H": "既有真实dialog/资源释放可测；没有为拆类型暴露私有状态。"
      },
      "decision": "review; module gates and actual remaining contracts pending"
    },
    {
      "path": "packages/game/src/core/battle/battle-settlement-data.ts",
