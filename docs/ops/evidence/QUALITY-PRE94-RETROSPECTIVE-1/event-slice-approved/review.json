    {
      "path": "packages/pal-extract/src/events/slice.ts",
      "sha256": "249ef69f1cb4e9e5ed79adbc740c32cd8dd0b7c5cafaf71d6adb79bf43c60e2a",
      "lines": 191,
      "read": "base全文+当前全部差异/实现全文；既有primary按具体范围复用",
      "dimensions": {
        "A": "唯一生产caller为CLI的dense disasm/annotate与parsed u16入口；6条原生业务红后修两类边，原始字节码roundtrip不变。同步纯函数，无取消/清理资源；未授每个切片独立执行信用。",
        "B": "删旧用户故障推断头注，说明保守潜在边、借用对象与IO边界；counted goto依据SDL trigger/auto分支，metadata不作为控制流。",
        "C": "入口、遍历、归属、改写各私有职责明确；局部queue/visited由同一collectReachable独占，无外部状态/反向依赖。",
        "D": "两份修复后BFS正文alpha等价再合并，无模式布尔；归属规则在遍历外，旧body/新body AST和其它emitted JS守恒。",
        "E": "6真红、53相邻绿、最终全包452绿；原盘17站点静态观察与纯重构全文输出同一，不当游戏表现oracle。",
        "F": "main只编排入口/归属/输出，共用短遍历；原下标/owner名保留；不按复杂度数字给accept。",
        "G": "无新增公共出口、未来抽象或无caller helper；现存typed tuple/同长数组的防御??0仍是精简候选，未顺手改变不支持输入合同。",
        "H": "parsed值可直接注入，输出可观察、无IO/随机/时钟；真实CLI接线仍由共享宿主全链测试。"
      },
      "decision": "review; rolling unified gates not run"
    },
    {
