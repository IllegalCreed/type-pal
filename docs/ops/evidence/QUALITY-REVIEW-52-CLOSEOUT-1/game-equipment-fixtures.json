    {
      "path": "packages/game/src/core/equipment-state.ts",
      "sha256": "4993411b4f30cb53f0f21a3c170748132c9d1ec8ab6ff4e94a931def846c2205",
      "lines": 391,
      "status": "code-accepted",
      "dimensions": {
        "A": "完整当前读，复用global.c真实getter/row布局及已获批TS持续增长、Wear压缩不丢毒取舍；base与六件+Extra顺序不变，毒抗独立clamp。",
        "B": "去过时投影行号及全称1:1；清楚区分base投影、战斗hp/mp ownership、装备层与已批准不复制C丢毒边界。",
        "C": "本模块是派生值/字段写入owner；私有sum仅收Pick的runtime/effect两域，不触脚本/IO；resync只改派生snapshot，不回灌live hp/mp。",
        "D": "六getter完全同输入/求和/失败策略，抽单一private helper且保留毒抗后置约束；add/set/override行集合不同，不建万能模式表。",
        "E": "E1六getter与现有equip-effect/E2/E5/poison owner测试；CoveredBy非零前像写零有指定漏写单红，Wear真实身份/洞压缩证据复用。",
        "F": "field联合型明确仅六属性，part上界MAX6含Extra；显式row分支保持布局可查，名字不把裸值与派生值混淆。",
        "G": "六重复循环减少到一处维护点；所有字段写/卸装/hand状态分支都有caller，不删除有效防御或已批准机制。",
        "H": "纯可变typed state输入，结果数组可直接观测，无隐式时间/网络；poison catalog由测试安装和复位，不为测试扩公开状态。"
      },
      "readScope": "Existing full author review reused where cited; Codex full current target source/test and focused real caller/lifecycle/primary deltas actually read; no repeated full dependent module credit.",
      "remaining": "No blocking eight-axis gap for this file. Uniform gates and remote publication remain pending."
