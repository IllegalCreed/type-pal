import datetime,hashlib,json,os,pathlib,subprocess,sys
root=pathlib.Path('/Users/zhangxu/.codex/worktrees/docs-integrity-readonly/type-pal');out=pathlib.Path(__file__).parent/sys.argv[2];head=sys.argv[1]
out.mkdir();env=dict(os.environ,NODE_PATH='/Users/zhangxu/illegal/type-pal/node_modules')
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,timeout=30).decode().strip()==head
