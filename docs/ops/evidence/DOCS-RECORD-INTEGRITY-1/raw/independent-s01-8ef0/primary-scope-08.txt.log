74: 
75: /** 一个待画精灵：脚下锚点 + 世界坐标（worldX = 中心，worldY = 脚的深度）。 */
76: export interface SpriteDraw {
77:   frame: RleFrame
78:   worldX: number
79:   worldY: number
80:   anchorX: number
81:   anchorY: number
82:   /** 画序偏置(原版 sLayer 人工覆盖;加进 baseY 排序键,不动 blit 位置)。 */
83:   baseYBias?: number
84:   /** 精灵类别的固定排序偏移：NPC=9，队伍=10（sdlpal scene.c:302/225）。 */
85:   sortOffset?: number
86:   /** PAL_CalcCoverTiles 的 iLayer；缺省表示普通 NPC 的兼容几何。 */
87:   coverILayer?: number
88:   /** PAL_CalcCoverTiles 的 sortY 偏移(队伍=10，NPC=9)。 */
89:   coverSortOffset?: number
90:   /** 不透明度(编辑器幽灵渲染等;缺省 1)。 */
91:   alpha?: number
92:   /** 是否允许局部前景透视：大世界仅主角队伍 true；普通遮挡/深度排序与此标记无关。 */
93:   occlusionTrigger?: boolean
94: }
95: 
96: /**
97:  * 精灵世界域 blit 矩形。脚底中点(anchorX=w/2, anchorY=h)对准格中心，
98:  * 当前二阶段素材采用统一7px绘制偏移，不要求与Game队伍的4px逐像素一致。
99:  * 所有画/命中消费点(引擎 blit、编辑器选中框/命中盒)必须走这里 —— 别在调用侧手写
100:  * `worldY − anchorY + 7`(编辑器曾漏 +7 致选中框偏高,2026-07-07 作者报)。
101:  */
102: export function spriteBlitRect(s: {
103:   worldX: number
104:   worldY: number
105:   anchorX: number
106:   anchorY: number
107:   frame: { width: number; height: number }
108: }): { x: number; y: number; w: number; h: number } {
109:   return {
110:     x: s.worldX - s.anchorX,
111:     y: s.worldY - s.anchorY + 7,
112:     w: s.frame.width,
113:     h: s.frame.height,
114:   }
115: }
