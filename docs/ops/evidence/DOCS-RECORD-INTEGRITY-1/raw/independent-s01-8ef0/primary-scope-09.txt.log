368:   /**
369:    * PAL_CalcCoverTiles 的 sprite-specific 候选扫描。
370:    * ProjectMap 的 lattice 行 `2 * dy + dh` 正好对应旧地图 cell 的
371:    * `(dy, dh)`；保留原版的五邻 tile 候选和高度门，避免把视口内所有高瓦片
372:    * 都重画成“全屏遮罩”。
373:    */
374:   private coverTileCandidates(
375:     tilesByLattice: ReadonlyMap<string, readonly ProjectMapTileDraw[]>,
376:     sprite: SpriteDraw,
377:   ): { tile: ProjectMapTileDraw; image: HTMLCanvasElement; baseY: number }[] {
378:     const spriteW = sprite.frame.width
379:     const spriteH = sprite.frame.height
380:     const iLayer = sprite.coverILayer ?? 0
381:     const sx = sprite.worldX - Math.floor(spriteW / 2) - Math.floor(iLayer / 2)
382:     const sy = sprite.worldY + (sprite.coverSortOffset ?? 9) - iLayer
383:     const sh = ((sx % TILE_W) + TILE_W) % TILE_W !== 0 ? 1 : 0
384:     const yStart = Math.trunc((sy - spriteH - 15) / TILE_H)
385:     const yEnd = Math.trunc(sy / TILE_H)
386:     const xStart = Math.trunc((sx - Math.floor(spriteW / 2)) / TILE_W)
387:     const xEnd = Math.trunc((sx + Math.floor(spriteW / 2)) / TILE_W)
388:     const out: { tile: ProjectMapTileDraw; image: HTMLCanvasElement; baseY: number }[] = []
