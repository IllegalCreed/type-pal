      "id": "independent-view-command-oracle",
      "path": "packages/pal-extract/src/events/disasm.glm-runtime-resource.test.ts",
      "reason": "Assert both standalone and odd-offset view against independent commands. Existing same-SUT comparison could pass when both lose the goto count. Test quality change, not pure body invariance or a product fix.",
      "changes": [
        {
          "from": "expect(disasm(parent.subarray(7, 7 + bc.length), ['x'], [2])).toEqual(disasm(bc, ['x'], [2]))",
          "to": "const expected = [\n      { op: 'goto', to: 'L_2', frameDelay: 5 },\n      { op: 'end' },\n      { op: 'end', label: 'L_2' },\n    ]\n    expect(disasm(bc, ['x'], [2])).toEqual(expected)\n    expect(disasm(parent.subarray(7, 7 + bc.length), ['x'], [2])).toEqual(expected)",
          "count": 1
        }
      ]
    }
