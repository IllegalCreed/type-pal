    {
      "id": "independent-view-oracle-battle-fields",
      "path": "packages/pal-extract/src/resources/parsers/battle-fields.glm-runtime-resource.test.ts",
      "reason": "The former comparison calls the same SUT twice; replace with independent full domain objects for both inputs, keep one original case and all original input values.",
      "changes": [
        {
          "from": "expect(parseBattleFields(parent.subarray(11))).toEqual(parseBattleFields(bytes))",
          "to": "const expected = [\n      {\n        id: 0,\n        screenWave: 0xffff,\n        magicEffect: { wind: 1, thunder: -2, water: 0x7fff, fire: -0x8000, earth: 0 },\n      },\n      {\n        id: 1,\n        screenWave: 0x0100,\n        magicEffect: { wind: -0x7fff, thunder: 2, water: -3, fire: 100, earth: -100 },\n      },\n    ]\n    expect(parseBattleFields(parent.subarray(11))).toEqual(expected)\n    expect(parseBattleFields(bytes)).toEqual(expected)",
          "count": 1
        },
        {
          "from": "大缓冲奇数偏移 subarray：与独立缓冲全等（12B 记录 × 2）",
          "to": "大缓冲奇数偏移 subarray：两条战场记录逐字段精确",
          "count": 1
        }
      ]
    },
    {
