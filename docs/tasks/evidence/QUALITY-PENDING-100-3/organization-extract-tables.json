      "id": "independent-view-oracle-stores",
      "path": "packages/pal-extract/src/resources/parsers/stores.glm-runtime-resource.test.ts",
      "reason": "The former comparison calls the same SUT twice; replace with independent full domain objects for both inputs, keep one original case and all original input values.",
      "changes": [
        {
          "from": "expect(parseStores(parent.subarray(5))).toEqual(parseStores(bytes))",
          "to": "const expected = [\n      { id: 0, items: [61] },\n      { id: 1, items: [62, 63] },\n    ]\n    expect(parseStores(parent.subarray(5))).toEqual(expected)\n    expect(parseStores(bytes)).toEqual(expected)",
          "count": 1
        },
        {
          "from": "奇数偏移 subarray：与独立缓冲全等",
          "to": "奇数偏移 subarray：两条记录逐字段精确",
          "count": 1
        }
      ]
