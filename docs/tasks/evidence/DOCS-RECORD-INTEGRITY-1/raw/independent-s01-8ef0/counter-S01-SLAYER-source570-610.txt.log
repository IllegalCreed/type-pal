592:     const capturedSY = sy
593:     const capturedNpcId = npc.id
594:     entries.push({
595:       baseY: sortY,
596:       draw: (f) => drawSprite(f, capturedSprite, capturedSX, capturedSY + 7),
597:       id: `npc-${capturedNpcId}`,
598:     })
599:     // cover tiles for NPC — sy 与 iLayer 都用 sLayer 计算
600:     addCoverTileEntries(
601:       entries,
602:       ctx.tilemap,
603:       ctx.tileImages,
604:       npc.x,
605:       sortY,
606:       capturedSprite.width,
607:       capturedSprite.height,
608:       gs.camera,
609:       `npc-${capturedNpcId}`,
610:       iLayer,
