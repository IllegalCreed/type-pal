{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vitest/globals"],
    "baseUrl": "../../../../",
    "paths": {
      "@type-pal/content": ["packages/content/src/index.ts"],
      "@type-pal/shared": ["packages/shared/src/index.ts"],
      "@type-pal/reforge": ["packages/reforge/src/index.ts"],
      "@lab/editor/edit-session": ["packages/editor/src/core/edit-session.ts"],
      "@lab/editor/commands": ["packages/editor/src/core/commands.ts"],
      "@lab/editor/map-mode": ["packages/editor/src/ui/MapMode.tsx"],
      "@lab/editor/script-editor-body": ["packages/editor/src/ui/ScriptEditor.tsx"],
      "@lab/editor/playback": ["packages/editor/src/core/playback.ts"],
      "@lab/editor/app": ["packages/editor/src/ui/App.tsx"]
    }
  },
  "include": [
    "../candidates/**/*.ts",
    "../candidates/**/*.tsx"
  ]
}
