        compile({
          kind: 'stages',
          initial: 'one',
          stages: [{ id: 'one', body: [{ kind: 'callScript', script: 'other' }] }],
        }),
        { cursorController: controller() },
      ),
      ).rejects.toThrow('ScriptRunnerCore: 无 resolver，无法解析 probe') // 变异轴：script id probe→other（合法 id）