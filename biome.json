{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/reference",
      "!**/data",
      "!**/pnpm-lock.yaml",
      "!**/*.min.js",
      "!**/public",
      "!docs/phase2/archive/mockups",
      "!.qoder",
      "!packages/game/src/dev/fixtures",
      "!packages/migrate/baselines",
      "!projects"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noThenProperty": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useSimpleNumberKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/reforge/**", "packages/content/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noNonNullAssertedOptionalChain": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/editor/src/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["N", "Num", "NumIn"]
              }
            }
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/editor/src/ui/editor.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
