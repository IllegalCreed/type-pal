{
  "name": "@type-pal/migrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:fast",
    "test:fast": "pnpm run test:manifest && vitest run --config vitest.config.ts --project unit --project pal-lite --project pal-oracle",
    "test:canary": "vitest run --config vitest.canary.config.ts",
    "test:canary:update": "tsx scripts/build-pal-source-canary.mts --write",
    "test:release:profile": "tsx scripts/profile-release.mts",
    "test:release:shuffle": "vitest run --config vitest.release.config.ts --project release-pal-shared --sequence.shuffle.files",
    "test:synthetic:shuffle": "vitest run --config vitest.shuffle.config.ts --sequence.shuffle.files",
    "test:release": "pnpm run test:manifest && pnpm run test:canary && vitest run --config vitest.release.config.ts",
    "test:oracle:verify": "vitest run --config vitest.config.ts --project pal-oracle",
    "test:oracle:update": "tsx scripts/build-pal-test-oracle.mts --write",
    "test:manifest": "tsx scripts/verify-test-manifest.mts --check",
    "test:manifest:update": "tsx scripts/verify-test-manifest.mts --write",
    "check": "pnpm typecheck && pnpm test:release",
    "check:fast": "pnpm typecheck && pnpm test:fast",
    "check:release": "pnpm typecheck && pnpm test:release",
    "audit:maps": "tsx scripts/audit-project-maps.mts",
    "audit:script-control-flow": "tsx scripts/audit-script-control-flow.mts",
    "audit:w9-lifecycle-ledger": "tsx scripts/audit-pal-w9-lifecycle-ledger.mts",
    "audit:sprite-actions": "tsx scripts/audit-pal-sprite-actions.mts",
    "audit:a7-sound-diff": "tsx scripts/audit-a7-sound-diff.mts",
    "audit:c1-npc-candidates": "tsx scripts/audit-pal-c1-npc-candidates.mts",
    "audit:c1-npc-first-batch": "tsx scripts/draft-pal-c1-npc-first-batch.mts",
    "audit:sounds": "tsx scripts/audit-pal-sounds.mts",
    "bake": "tsx scripts/bake-assets.mts",
    "migrate:script-v5:shadow": "tsx scripts/migrate-script-v5-shadow.mts",
    "migrate:content": "tsx scripts/migrate-content.mts"
  },
  "dependencies": {
    "@type-pal/content": "workspace:*",
    "@type-pal/shared": "workspace:*"
  },
  "devDependencies": {
    "@type-pal/reforge": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.3"
  }
}
