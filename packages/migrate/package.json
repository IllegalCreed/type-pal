  "dependencies": {
    "@type-pal/content": "workspace:*",
    "@type-pal/shared": "workspace:*"
  },
  "devDependencies": {
    "@type-pal/reforge": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.3"
