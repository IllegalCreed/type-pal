{
  "name": "@type-pal/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:design-system": "node scripts/audit-legacy-controls.mjs --gate",
    "dev": "VITE_PROJECT_ID=pal vite --port 6010 --strictPort",
    "dev:lan": "EDITOR_LAN_HTTPS=1 VITE_PROJECT_ID=pal vite --host 0.0.0.0 --port 6010 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test",
    "dev:demo": "vite --port 6011 --strictPort"
  },
  "dependencies": {
    "@type-pal/content": "workspace:*",
    "@type-pal/reforge": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@bramus/specificity": "2.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "29.1.1",
    "vite": "^8.0.14"
  }
}
